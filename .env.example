# --- required -----------------------------------------------------------
# boat.dev API key. `boat api-key create dinghy --preset ci --ttl 365d`
BOAT_API_KEY=
# Any long random string; paste the same value into the GitHub webhook.
GITHUB_WEBHOOK_SECRET=
# Either a PAT (classic: repo / admin:org, or fine-grained: "Administration: write" on the repos)...
GITHUB_TOKEN=
# ...or a GitHub App (Administration: write for repos, Self-hosted runners: write for orgs).
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=

# --- dashboard ---------------------------------------------------------
# Basic auth for the dashboard (user "admin"). Unset = dashboard off, webhook still works.
DINGHY_ADMIN_PASSWORD=
# Public URL, only used to render setup instructions.
DINGHY_PUBLIC_URL=

# --- runners -----------------------------------------------------------
# Jobs with `runs-on: [self-hosted, dinghy]` (or dinghy-small/-default/-large/-xlarge) are picked up.
DINGHY_LABEL=dinghy
DINGHY_DEFAULT_SIZE=small
DINGHY_MAX_CONCURRENT=20
# "repo" registers runners per repository; "org" on the organization (needs org admin).
DINGHY_RUNNER_SCOPE=repo
DINGHY_RUNNER_GROUP_ID=1
# Comma-separated GitHub owners allowed to use this instance. Empty = anyone whose webhook you configured.
DINGHY_ALLOWED_OWNERS=
# Use your own saved boat snapshot instead of the one dinghy bakes.
DINGHY_SNAPSHOT=
# Shell run on every runner before it starts / once when baking the snapshot.
DINGHY_PRE_SCRIPT=
DINGHY_BAKE_SCRIPT=
DINGHY_IDLE_TIMEOUT_SECONDS=600
DINGHY_MAX_JOB_SECONDS=21600
DINGHY_RUNNER_VERSION=2.338.2
# Unique per install if several dinghys share one boat account.
DINGHY_INSTANCE=main

# --- reselling ---------------------------------------------------------
# Markup applied in the per-owner usage report and /api/usage.
DINGHY_MARKUP_PERCENT=30
DINGHY_CURRENCY=USD
