{
  "name": "dinghy",
  "version": "0.1.0",
  "description": "Self-hosted, ephemeral GitHub Actions runners on boat.dev VMs. Deploy to a VPS, Cloudflare Workers or Railway.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --watch src/bun/server.ts",
    "start": "bun src/bun/server.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy"
  },
  "dependencies": {
    "hono": "^4.13.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261026.1",
    "@types/bun": "latest",
    "typescript": "^5.9.0",
    "wrangler": "^4.153.0"
  }
}
